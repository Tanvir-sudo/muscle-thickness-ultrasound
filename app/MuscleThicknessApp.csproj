<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
  </ItemGroup>

  <!-- Copy the ONNX model and its external weights next to the executable -->
  <ItemGroup>
    <None Include="..\models\apo_model.onnx" Link="apo_model.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\models\apo_model.onnx.data" Link="apo_model.onnx.data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
