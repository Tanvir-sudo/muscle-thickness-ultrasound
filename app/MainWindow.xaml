<Window x:Class="MuscleThicknessApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Muscle Thickness Tool"
        Width="1400"
        Height="850"
        MinWidth="1250"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <Grid>

        <!-- ========================= HEADER ========================= -->
        <Grid Height="90" VerticalAlignment="Top" Background="#1E293B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE -->
            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="20" VerticalAlignment="Center">
                <TextBlock Text="AI Muscle Thickness Tool"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Team: Neuroheal | Mentor: SRBD Co. Ltd"
                           FontSize="12"
                           Foreground="#94A3B8"/>
            </StackPanel>

            <!-- RIGHT BUTTON BAR -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="10">

                <Button Content="1. Load Image"
                        Width="180"
                        Height="44"
                        Margin="8"
                        Background="#3B82F6"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BtnLoadImage_Click"/>

                <Button Content="2. Run Segmentation"
                        Width="210"
                        Height="44"
                        Margin="8"
                        Background="#22C55E"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BtnSegment_Click"/>

                <Button Content="3. Draw ROI"
                        Width="160"
                        Height="44"
                        Margin="8"
                        Background="#F59E0B"
                        Foreground="Black"
                        FontWeight="Bold"/>

                <Button Content="4. Compute Muscle Thickness"
                        Width="280"
                        Height="44"
                        Margin="8"
                        Background="#D946EF"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BtnThickness_Click"/>

            </StackPanel>
        </Grid>
        <!-- ========================= END HEADER ========================= -->


        <!-- ========================= MAIN BODY ========================= -->

        <Grid Margin="20,110,20,60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- IMAGE DISPLAY -->
            <Border Grid.Column="0" CornerRadius="12"
                    BorderBrush="#334155"
                    BorderThickness="2"
                    Background="#020617"
                    Padding="10"
                    Margin="10">

                <Grid>
                    <Image x:Name="MainImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    <Canvas x:Name="RoiCanvas"
                            Background="Transparent"
                            MouseLeftButtonDown="RoiCanvas_MouseLeftButtonDown"
                            MouseMove="RoiCanvas_MouseMove"
                            MouseLeftButtonUp="RoiCanvas_MouseLeftButtonUp">

                        <Rectangle x:Name="RoiRect"
                                   Stroke="LimeGreen"
                                   StrokeThickness="2"
                                   Visibility="Collapsed"/>
                    </Canvas>
                </Grid>
            </Border>

            <!-- THICKNESS PANEL -->
            <Border Grid.Column="1"
                    CornerRadius="12"
                    Background="#020617"
                    BorderBrush="#334155"
                    BorderThickness="2"
                    Padding="15"
                    Margin="10">

                <StackPanel>

                    <TextBlock Text="Computed Muscle Thickness"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,15"/>

                    <Border Background="#020617"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">

                        <TextBlock x:Name="ThicknessText"
                                   Text="-- px (-- mm)"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#22FF99"/>
                    </Border>

                </StackPanel>

            </Border>

        </Grid>

        <!-- ========================= STATUS BAR ========================= -->

        <Border VerticalAlignment="Bottom"
                Height="40"
                Background="#1E293B">

            <TextBlock x:Name="StatusText"
                       Text="Ready."
                       Foreground="#E5E7EB"
                       VerticalAlignment="Center"
                       Margin="15"/>

        </Border>

    </Grid>
</Window>











